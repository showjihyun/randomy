{
  "name": "randomy",
  "build": { "dockerfile": "Dockerfile" },
  "workspaceFolder": "/workspaces/randomy",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/randomy,type=bind",
  "mounts": [
    "source=randomy-node-modules,target=/workspaces/randomy/frontend/node_modules,type=volume"
  ],
  "remoteUser": "node",
  "containerEnv": {
    "RANDOMY_DB_PATH": "/home/node/randomy.db"
  },
  "forwardPorts": [5173, 8000],
  "postCreateCommand": "make setup",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "anthropic.claude-code"
      ]
    }
  }
}
